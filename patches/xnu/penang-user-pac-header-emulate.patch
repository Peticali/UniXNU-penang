+/*
+ * penang: the pages of a Mach-O image that exec checks against the code signature again (parse_machfile validates the
+ * header and load commands, 32 + sizeofcmds bytes from the image start, page by page, and refuses a CS_KILL image on a
+ * mismatch). A rewrite in such a file page made every later exec of the same binary fail with EBADEXEC: xpcproxy, whose
+ * code shares page 0 with its header, then refused every launchd spawn on demand (u27-disp9, "invalid initial page at
+ * offset 0"). An instruction there is emulated each time instead; the image start is the closest page start at or
+ * below pc, at most 16 KiB back, that holds MH_MAGIC_64.
+ */
+static bool
+penang_pac_in_header_pages(uint64_t pc)
+{
+	uint64_t page = pc & ~0xfffULL;
+	for (unsigned back = 0; back < 4 && page >= 0x1000ULL * back; ++back) {
+		uint64_t base = page - 0x1000ULL * back;
+		uint32_t head[6];
+		if (copyin((user_addr_t)base, head, sizeof(head)) != 0) {
+			return false;
+		}
+		if (head[0] == 0xfeedfacfU) {
+			/* Only an executable (MH_EXECUTE) or dyld (MH_DYLINKER) is checked again by exec. Every dylib of the shared cache
+			 * also begins with a header: with those included, page 0 of each cached library trapped on every execution of
+			 * every PAC instruction (u27-smp7: 7.4 M emulations in 2 min). */
+			if (head[3] != 2U && head[3] != 7U) {
+				return false;
+			}
+			uint64_t end = (base + 32 + head[5] + 0xfffULL) & ~0xfffULL;
+			return pc < end;
+		}
+	}
+	return false;
+}
+
+/* The ARMv8.0 replacement of a rewrite, executed once instead of written: ret/br/blr Xn, nop, mov Xd, xzr. */
+static bool
+penang_pac_emulate(arm_saved_state64_t *ss, uint32_t r)
+{
+	uint64_t pc = ss->pc;
+	unsigned rn = (r >> 5) & 31U;
+	if ((r & 0xfffffc1fU) == 0xd65f0000U || (r & 0xfffffc1fU) == 0xd61f0000U) {
+		ss->pc = penang_pac_reg(ss, rn, false);                 /* ret Xn / br Xn */
+	} else if ((r & 0xfffffc1fU) == 0xd63f0000U) {
+		uint64_t target = penang_pac_reg(ss, rn, false);
+		ss->lr = pc + 4;                                        /* blr Xn */
+		ss->pc = target;
+	} else if (r == 0xd503201fU) {
+		ss->pc = pc + 4;                                        /* nop */
+	} else if ((r & 0xffffffe0U) == 0xaa1f03e0U) {
+		penang_pac_set_reg(ss, r & 31U, 0, false);              /* mov Xd, xzr */
+		ss->pc = pc + 4;
+	} else {
+		return false;
+	}
+	return true;
+}
