+/*
+ * penang: the kernel console also goes to Linux's ramoops console zone, after the UEFI's own log. The moto g53 has
+ * no UART; DDR at 0xaf03f800 (dtbo ramoops_mem 0xaf000000 + 0x3f800, 0x40000 bytes) survives the warm reset, and
+ * the next Linux boot (the penang UMS image) hands it back as /sys/fs/pstore/console-ramoops-0. Same ring as
+ * Mu-Silicium's FrameBufferSerialPortLib PenangPramWrite: header {u32 sig "DBGC", u32 start, u32 size}, then data.
+ * penang_pram_va is mapped by kernel_bootstrap_thread (startup.c); the panic screen reads it too.
+ */
+#define PENANG_PRAM_SIG  0x43474244U
+#define PENANG_PRAM_DATA (0x40000U - 12U)
+volatile uint8_t *penang_pram_va;
+
+/*
+ * penang: room in kernel text for the payload's panic screen (UniXNU scripts/patch-xnu-entry-probe.py uses
+ * _penang_panic_cave, 0x1000 bytes of brk #1, when the kernel has it). With the persistent ring and the timed reset the
+ * screen outgrows the shared padding it otherwise uses; until the payload writes it there this is never called.
+ */
+__attribute__((naked, used, noinline, aligned(64))) void penang_panic_cave(void);
+void
+penang_panic_cave(void)
+{
+	__asm__ volatile (".rept 1024\n\tbrk #1\n\t.endr");
+}
+
+void penang_pram_write(const char *text, size_t length);
+void penang_pram_map_early(void);
+void
+penang_pram_map_early(void)
+{
+	/* Right after arm_vm_init: io_map takes virtual space from virtual_space_start before kmem is up. */
+	penang_pram_va = (volatile uint8_t *)ml_io_map(0xaf03f800ULL, 0x40000);
+	static const char banner[] = "\n==== penang XNU console (ramoops mirror) ====\n";
+	penang_pram_write(banner, sizeof(banner) - 1);
+}
+
+void penang_pram_write(const char *text, size_t length);
+void
+penang_pram_write(const char *text, size_t length)
+{
+	volatile uint32_t *header = (volatile uint32_t *)penang_pram_va;
+	if (header == NULL) {
+		return;
+	}
+	volatile uint8_t *data = penang_pram_va + 12;
+	if (header[0] != PENANG_PRAM_SIG || header[1] >= PENANG_PRAM_DATA || header[2] > PENANG_PRAM_DATA) {
+		header[0] = PENANG_PRAM_SIG;
+		header[1] = 0;
+		header[2] = 0;
+	}
+	uint32_t start = header[1], size = header[2];
+	for (size_t i = 0; i < length; i++) {
+		data[start] = (uint8_t)text[i];
+		start = (start + 1) % PENANG_PRAM_DATA;
+		if (size < PENANG_PRAM_DATA) {
+			size++;
+		}
+	}
+	header[1] = start;
+	header[2] = size;
+}
