+/*
+ * penang: unattended runs. The ramoops console zone the console mirrors into is mapped by arm_init
+ * (penang_pram_map_early, osfmk/console/serial_console.c); here, with penang-autoreset=<seconds>, resets the board that long after this point
+ * through PSCI SYSTEM_RESET (smc, the conduit of the moto g53's firmware; the board then returns to fastboot), after a
+ * marker in that zone. A boot that hangs without a panic thus comes back by itself, its console readable from Linux.
+ */
+extern volatile uint8_t *penang_pram_va;
+extern void penang_pram_write(const char *text, size_t length);
+
+static void
+penang_psci_reset(void)
+{
+	(void) ml_set_interrupts_enabled(FALSE);
+	for (;;) {
+		/*
+		 * PSCI SYSTEM_RESET2, SYSTEM_WARM_RESET first: SYSTEM_RESET is a PMIC hard reset here ("Power-on reason:
+		 * Triggered from Hard Reset and 'cold' boot"), the rails drop and DDR loses bits (the ramoops header too, so
+		 * Linux drops the whole zone). A warm reset keeps DDR in self-refresh. SYSTEM_RESET if TZ refuses it.
+		 */
+		register uint64_t r2 __asm__("x0") = 0xC4000012ULL;
+		register uint64_t type __asm__("x1") = 0;
+		register uint64_t cookie __asm__("x2") = 0;
+		__asm__ volatile ("smc #0" : "+r"(r2), "+r"(type), "+r"(cookie) : : "x3", "memory");
+		register uint64_t x0 __asm__("x0") = 0x84000009ULL;   /* PSCI SYSTEM_RESET */
+		__asm__ volatile ("smc #0" : "+r"(x0) : : "x1", "x2", "x3", "memory");
+	}
+}
+
+static void
+penang_autoreset_thread(void *parameter, __unused wait_result_t result)
+{
+	uint32_t seconds = (uint32_t)(uintptr_t)parameter;
+	assert_wait_timeout((event_t)&penang_autoreset_thread, THREAD_UNINT, seconds, NSEC_PER_SEC);
+	thread_block(THREAD_CONTINUE_NULL);
+	static const char marker[] = "\npenang: autoreset deadline reached, PSCI SYSTEM_RESET\n";
+	penang_pram_write(marker, sizeof(marker) - 1);
+	penang_psci_reset();
+}
+
+static void
+penang_pram_start(void)
+{
+	uint32_t seconds = 0;
+	if (PE_parse_boot_argn("penang-autoreset", &seconds, sizeof(seconds)) && seconds > 0) {
+		thread_t thread;
+		if (kernel_thread_start(penang_autoreset_thread, (void *)(uintptr_t)seconds, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		}
+		printf("penang: autoreset in %u s\n", seconds);
+	}
+}
