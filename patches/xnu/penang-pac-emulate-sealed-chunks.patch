+/*
+ * penang: whether a user text address lies in a file whose pages the user PAC trap must not rewrite in place. The sealed system
+ * volumes keep files compressed in 16 KiB chunks, each with its own hash, while this kernel pages in 4 KiB: once the trap rewrote a
+ * page of libobjc-trampolines.dylib (offset 0x4000, the trampoline page objc remaps for every block IMP), the next page-in of a
+ * neighbour in the same chunk hashed the rewritten resident page with it ("Data hash mismatch ... 16384 bytes at offset 16384 in
+ * compressed data stream 4833 of inode 4832", decmpfs err 94) and SpringBoard died of SIGBUS while building the lock screen
+ * (u27-cs1). Its PAC instructions are emulated instead (penang-user-pac-header-emulate's path).
+ */
+extern const char *vnode_getname(struct vnode *vp);
+extern void vnode_putname(const char *name);
+bool penang_pac_file_needs_emulation(vm_map_offset_t addr);
+bool
+penang_pac_file_needs_emulation(vm_map_offset_t addr)
+{
+	task_t task = current_task();
+	vm_object_t object = NULL;
+	vm_object_offset_t offset;
+	vm_page_t page = NULL;
+	vm_prot_t prot;
+	bool emulate = false;
+	VM_MAP_LOCK_CTX_DECLARE(ctx);
+
+	if (task == TASK_NULL || task->map == VM_MAP_NULL) {
+		return false;
+	}
+	if (vmtc_revalidate_lookup(task->map, ctx, addr, &object, &offset, &page, &prot) != KERN_SUCCESS) {
+		return false;
+	}
+	if (object->pager != NULL) {
+		struct vnode *vnode = vnode_pager_lookup_vnode(object->pager);
+		const char *name = vnode ? vnode_getname(vnode) : NULL;
+		if (name != NULL) {
+			emulate = strcmp(name, "libobjc-trampolines.dylib") == 0;
+			vnode_putname(name);
+		}
+	}
+	vm_object_unlock(object);
+	return emulate;
+}
+
 kern_return_t
 revalidate_text_page(task_t task, vm_map_offset_t code_addr)
 {
