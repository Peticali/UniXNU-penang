+/*
+ * The pages of files whose PAC instructions are emulated rather than rewritten (penang_pac_file_needs_emulation, vm_fault.c:
+ * libobjc-trampolines.dylib, compressed in hashed 16 KiB chunks). An emulated instruction traps on every execution, so the physical
+ * pages already found in such a file are remembered (objc remaps the trampoline page at many addresses, all one physical page).
+ */
+extern bool penang_pac_file_needs_emulation(vm_map_offset_t addr);
+static uint64_t penang_pac_emulated_pages[16];
+static uint32_t penang_pac_emulated_next;
+static bool
+penang_pac_in_emulated_file(uint64_t pc)
+{
+	uint64_t par;
+	__asm__ volatile ("at s1e1r, %1\n\tisb\n\tmrs %0, par_el1" : "=r"(par) : "r"(pc) : "memory");
+	if (par & 1) {
+		return false;
+	}
+	const uint64_t pa = par & 0x0000fffffffff000ULL;
+	for (unsigned i = 0; i < 16; ++i) {
+		if (__atomic_load_n(&penang_pac_emulated_pages[i], __ATOMIC_RELAXED) == pa) {
+			return true;
+		}
+	}
+	if (!penang_pac_file_needs_emulation((vm_map_offset_t)pc)) {
+		return false;
+	}
+	const uint32_t slot = __atomic_fetch_add(&penang_pac_emulated_next, 1, __ATOMIC_RELAXED) & 15U;
+	__atomic_store_n(&penang_pac_emulated_pages[slot], pa, __ATOMIC_RELAXED);
+	return true;
+}
