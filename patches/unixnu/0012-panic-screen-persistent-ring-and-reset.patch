diff --git a/scripts/xnu-panic-screen.c b/scripts/xnu-panic-screen.c
index 188a2c8..16e9b30 100644
--- a/scripts/xnu-panic-screen.c
+++ b/scripts/xnu-panic-screen.c
@@ -33,7 +33,63 @@ struct ctx {
   u32 rb, w, h, x, y;
   u8  *log;   /* kernel buffer that also receives the formatted message (PANIC_TEXT), 0 = none */
   u32 logn;
+  volatile u8 *pram;   /* the board's persistent console ring (PRAM_SLOT), 0 = none */
 };
+#ifndef PRAM_SLOT
+#define PRAM_SLOT 0UL
+#endif
+
+/* Optional: a kernel pointer variable holding the board's persistent console ring, the {u32 sig "DBGC", u32 start,
+ * u32 size} ring that Linux reads back as /sys/fs/pstore/console-ramoops-0 after a warm reset (penang XNU's
+ * penang_pram_va). Everything drawn is appended there too, so an unattended run's panic is read without a photograph. */
+#ifndef PRAM_SLOT
+#define PRAM_SLOT 0UL
+#endif
+#define PRAM_SIG  0x43474244u
+#define PRAM_DATA (0x40000u - 12u)
+/* Optional: seconds to keep the panic on the screen before PSCI SYSTEM_RESET (smc), 0 = stay. */
+#ifndef PANIC_RESET_SECONDS
+#define PANIC_RESET_SECONDS 0
+#endif
+
+#if PRAM_SLOT
+static void pram_put (volatile u8 *ring, u8 c)
+{
+  volatile u32 *h = (volatile u32 *)ring;
+  if (h[0] != PRAM_SIG || h[1] >= PRAM_DATA || h[2] > PRAM_DATA) {
+    h[0] = PRAM_SIG;
+    h[1] = 0;
+    h[2] = 0;
+  }
+  u32 start = h[1], size = h[2];
+  ring[12 + start] = c;
+  h[1] = (start + 1) % PRAM_DATA;
+  if (size < PRAM_DATA) {
+    h[2] = size + 1;
+  }
+}
+#endif
+
+#if PANIC_RESET_SECONDS
+__attribute__((noreturn)) static void reset_after (u64 seconds)
+{
+  u64 freq, start, now;
+  __asm__ volatile ("mrs %0, cntfrq_el0" : "=r" (freq));
+  __asm__ volatile ("isb\n\tmrs %0, cntvct_el0" : "=r" (start));
+  do {
+    __asm__ volatile ("isb\n\tmrs %0, cntvct_el0" : "=r" (now));
+  } while (now - start < seconds * freq);
+  for (;;) {
+    /* SYSTEM_RESET2 warm first: SYSTEM_RESET is a PMIC hard reset on the g53 and DDR (the persistent ring) decays. */
+    register u64 r2 __asm__ ("x0") = 0xC4000012UL;
+    register u64 type __asm__ ("x1") = 0;
+    register u64 cookie __asm__ ("x2") = 0;
+    __asm__ volatile ("smc #0" : "+r" (r2), "+r" (type), "+r" (cookie) : : "x3", "memory");
+    register u64 x0 __asm__ ("x0") = 0x84000009UL;   /* PSCI SYSTEM_RESET */
+    __asm__ volatile ("smc #0" : "+r" (x0) : : "x1", "x2", "x3", "memory");
+  }
+}
+#endif
 
 #ifndef PANIC_TEXT
 #define PANIC_TEXT 0UL
