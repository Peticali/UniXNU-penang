diff --git a/NativeAdrenoMetalPlugin.mm b/NativeAdrenoMetalPlugin.mm
index ee72363..9bd1cab 100644
--- a/NativeAdrenoMetalPlugin.mm
+++ b/NativeAdrenoMetalPlugin.mm
@@ -704,6 +704,21 @@ static id deviceForPort(unsigned port) {
 }  // namespace publish
 
 @implementation NativeAdrenoMetalDevice
+// PENANG: processes named in /private/var/local/native-metal-exclude (one per line) get no native device and keep their CPU
+// path, as IOS-26-Hot keeps WidgetRenderer_Default / PosterBoard off Metal (RenderBox _RB4 two-plane targets).
+static bool penangExcluded() {
+    FILE *f = fopen("/private/var/local/native-metal-exclude", "r");
+    if (!f) return false;
+    char line[128];
+    bool hit = false;
+    const char *me = getprogname();
+    while (!hit && fgets(line, sizeof line, f)) {
+        line[strcspn(line, "\r\n")] = 0;
+        hit = line[0] && !strcmp(line, me);
+    }
+    fclose(f);
+    return hit;
+}
 - (id)initWithAcceleratorPort:(unsigned)port {
 #if TARGET_OS_OSX
     // The registered device is the frontend's object, not this one: IOGPUMetalDevice's own initializer would open an IOGPU user client.
@@ -717,6 +732,7 @@ static id deviceForPort(unsigned port) {
     self = [super init];
     if (!self || !port) return nil;
 #endif
+    if (penangExcluded()) return nil;
     if (publish::requested()) return publish::deviceForPort(port);
     static bool attempted;
     if (attempted) return nil;
